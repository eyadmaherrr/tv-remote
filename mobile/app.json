{
  "expo": {
    "name": "TV Remote",
    "slug": "tv-remote",
    "version": "1.0.0",
    "scheme": "tvremote",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0d12",
    "ios": {
      "bundleIdentifier": "com.eyadmaher.tvremote",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "TV Remote connects to your Samsung TV on your Wi-Fi to send remote-control commands.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "TV Remote turns your voice commands into remote presses.",
        "NSMicrophoneUsageDescription": "TV Remote uses the microphone for voice commands like \"open YouTube\"."
      }
    },
    "android": {
      "package": "com.eyadmaher.tvremote",
      "adaptiveIcon": {
        "backgroundColor": "#0b0d12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "TV Remote uses the microphone for voice commands like \"open YouTube\".",
          "speechRecognitionPermission": "TV Remote turns your voice commands into remote presses.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0b0d12"
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1e4561bb-b3e8-49c4-9ed1-35c3060e260d"
      }
    },
    "owner": "eyadmaher"
  }
}
