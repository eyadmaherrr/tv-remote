{
  "expo": {
    "name": "TV Remote",
    "slug": "tv-remote",
    "version": "1.0.0",
    "scheme": "tvremote",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0d12",
    "ios": {
      "bundleIdentifier": "com.eyadmaher.tvremote",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "TV Remote connects to your Samsung TV on your Wi-Fi to send remote-control commands.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.eyadmaher.tvremote",
      "adaptiveIcon": {
        "backgroundColor": "#0b0d12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "TV Remote uses the microphone for voice commands like \"open YouTube\".",
          "speechRecognitionPermission": "TV Remote turns your voice commands into remote presses.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0b0d12"
        }
      ]
    ]
  }
}